{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketcart",
  "account_id": "8aac1c15f7a44b8a902ba9e98f517a3e",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "pocketcart.app",
      "custom_domain": true
    },
    {
      "pattern": "www.pocketcart.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/blog",
      "/blog/*",
      "/sitemap.xml",
      "/admin",
      "/support",
      "/privacy",
      "/terms",
      "/delete-account",
      "/rendered/*"
    ],
    "html_handling": "none"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "main": ".web-server/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
