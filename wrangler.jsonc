{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocketcart",
  "account_id": "8aac1c15f7a44b8a902ba9e98f517a3e",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "routes": [
    { "pattern": "pocketcart.app", "custom_domain": true },
    { "pattern": "www.pocketcart.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
