# PocketCart environment variables
#
# Copy this file to .env for local development.
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: email confirmation redirect URL.
# Add the same URL to Supabase Auth > URL Configuration > Redirect URLs.
EXPO_PUBLIC_AUTH_REDIRECT_URL=pocketcart://auth/callback

# Optional: comma-separated emails allowed to access /admin.
# If left blank, any signed-in Supabase user can access the admin UI.
EXPO_PUBLIC_ADMIN_EMAILS=admin@example.com

# Optional: Supabase Storage bucket for product images.
# database/schema.sql creates the default "product-images" bucket.
EXPO_PUBLIC_SUPABASE_PRODUCT_IMAGE_BUCKET=product-images

# Optional: Google Analytics 4 measurement ID for web analytics.
EXPO_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: server-side endpoint that extracts flyer rows with AI.
# Do not put AI provider API keys in Expo client env vars.
EXPO_PUBLIC_FLYER_AI_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/functions/v1/back-office-flyer

# Server-side only. Use these as Supabase Edge Function secrets or local function env vars.
# These are intentionally not prefixed with EXPO_PUBLIC_.
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_PDF_PAGES=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FLYER_ADMIN_EMAILS=admin@example.com
