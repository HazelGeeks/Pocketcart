{
  "expo": {
    "name": "PocketCart",
    "slug": "pocketcart",
    "scheme": "pocketcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9fffb"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.pocketcart.app",
      "buildNumber": "1",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "PocketCart uses your location only when you choose to find nearby stores and deals."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#61e392"
      },
      "versionCode": 6,
      "package": "com.pocketcart.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png",
      "name": "PocketCart — Smart Price Comparison & Savings App",
      "shortName": "PocketCart",
      "description": "Compare prices, track alerts, and manage your budget in one app.",
      "lang": "en",
      "themeColor": "#61e392",
      "backgroundColor": "#f9fffb"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-font",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PocketCart uses your location only when you choose to find nearby stores and deals.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2c314b8-b5ac-443c-b848-819da5ef3d32"
      }
    }
  }
}
