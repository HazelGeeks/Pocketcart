{
  "name": "pocketcart",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "expo start --web",
    "dev:web": "expo start --web",
    "dev:native": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty false",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "build:web": "expo export --platform web",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:web"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~55.0.11",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.101.0",
    "babel-preset-expo": "~55.0.8",
    "expo": "^55.0.0",
    "expo-font": "~55.0.8",
    "framer-motion": "^12.34.3",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.10",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
