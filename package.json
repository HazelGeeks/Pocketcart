{
  "name": "pocketcart",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "dev": "node scripts/run-ios-current-simulator.mjs",
    "dev:ios": "npm run dev",
    "dev:client": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "node scripts/run-ios-current-simulator.mjs --build",
    "android": "expo run:android",
    "dev:worker": "npm run build:web && wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --diagnostic-level=error",
    "format": "biome format --write .",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:web",
    "audit:ci": "node scripts/check-npm-audit.mjs",
    "build": "npm run build:web",
    "build:web": "expo export --platform web && node scripts/fingerprint-web-entry.mjs",
    "deploy:worker:dry-run": "npm run build:web && wrangler deploy --dry-run",
    "deploy:worker": "npm run build:web && wrangler deploy",
    "backend:plan": "node scripts/supabase-release.mjs plan",
    "backend:release": "node scripts/supabase-release.mjs",
    "eas": "node scripts/eas-cli.mjs",
    "build:ios": "node scripts/eas-cli.mjs build --platform ios --profile production",
    "build:ios:local": "node scripts/eas-cli.mjs build --platform ios --profile production-local --local",
    "build:android": "node scripts/eas-cli.mjs build --platform android --profile production",
    "submit:ios": "node scripts/submit-store.mjs ios",
    "submit:android": "node scripts/submit-store.mjs android",
    "release:native:check": "npm run verify && npm run release:native:config-check && npm run release:store-assets:check",
    "release:native:config-check": "node scripts/check-mobile-release-readiness.mjs",
    "release:native:doctor": "node scripts/check-mobile-release-readiness.mjs --external",
    "release:native:setup-guide": "node scripts/print-mobile-release-setup-guide.mjs",
    "release:store-assets:check": "node scripts/check-store-submission-assets.mjs",
    "release:store-assets:live-check": "node scripts/check-store-submission-assets.mjs --live",
    "postinstall": "node scripts/apply-security-patches.mjs && node scripts/check-vendored-security.mjs",
    "eas-build-post-install": "node scripts/prepare-google-services.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "0.4.2",
    "@expo/metro-runtime": "55.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.106.2",
    "@tanstack/react-query": "5.101.0",
    "babel-preset-expo": "55.0.22",
    "base64-js": "1.5.1",
    "braces": "file:vendor/packages/pocketcart-braces-1.0.0.tgz",
    "expo": "55.0.29",
    "expo-apple-authentication": "55.0.16",
    "expo-camera": "55.0.22",
    "expo-crypto": "55.0.18",
    "expo-dev-client": "55.0.38",
    "expo-font": "55.0.8",
    "expo-location": "55.1.13",
    "expo-notifications": "55.0.26",
    "expo-web-browser": "55.0.19",
    "framer-motion": "12.34.3",
    "lucide-react-native": "1.33.0",
    "node-forge": "file:vendor/packages/pocketcart-node-forge-1.0.0.tgz",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-purchases": "10.9.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "0.21.2",
    "tesseract.js": "7.0.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.10",
    "@napi-rs/canvas": "1.0.0",
    "@types/react": "19.2.15",
    "eas-cli": "24.10.0",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "image-size": "2.0.4",
    "nanoid": "3.3.18",
    "uuid": "11.1.1",
    "braces": "$braces",
    "node-forge": "$node-forge",
    "eas-cli": {
      "ajv@8": "8.20.0",
      "joi@17": "17.13.8",
      "minimatch@5": "5.1.9",
      "tar@7": "7.5.22",
      "ts-deepmerge": "8.0.0",
      "yaml@2": "2.8.4"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
